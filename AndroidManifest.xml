<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <!-- libadb-android and spake2-android say minSdkVersion 1, and Android's
       manifest merger gives a library older than API 4 the storage and phone
       permissions of those days by itself: the app uses neither. -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
  <!-- ONNX Runtime's, for its telemetry alone, which is taken out below. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
  <!-- Android's own recognizer for 🎤 Local (AndroidSpeech): since Android 11
       an app sees the recognition services it names here. -->
  <queries>
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>
  <!-- The label is each product's: MainActivity.AppLabel. Back goes to the
       app's own handlers (OnBackInvokedDispatcher), which close a settings'
       page before the app. 🎤 by ia-voice goes to the address the user
       writes, http:// as well (their own computer at home), so plain
       traffic is let through. -->
  <application android:icon="@drawable/ic_keyplus"
               android:allowBackup="false"
               android:supportsRtl="true"
               android:enableOnBackInvokedCallback="true"
               android:usesCleartextTraffic="true">
    <!-- ONNX Runtime (the accent model) starts a telemetry of its own, with
         its own HTTP client, as the app opens; a keyboard sends nothing it
         was not asked to. -->
    <provider android:name="ai.onnxruntime.TelemetryInitializer"
              android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
              tools:node="remove" />
  </application>
</manifest>
