<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The label is each product's: MainActivity.AppLabel. Back goes to the
       app's own handlers (OnBackInvokedDispatcher), which close a settings'
       page before the app. -->
  <application android:icon="@drawable/ic_keyplus"
               android:allowBackup="false"
               android:supportsRtl="true"
               android:enableOnBackInvokedCallback="true" />
</manifest>
