<Project>

  <!-- The build number, raised by one by build-apk.ps1 on every APK it builds
       (rules.md): the version is 1.0.0.<BuildNumber>, and the Android version
       code is the build number itself, so each APK installs over the last. -->
  <PropertyGroup>
    <BuildNumber>22</BuildNumber>
  </PropertyGroup>

</Project>
