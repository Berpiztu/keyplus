<Project Sdk="Microsoft.NET.Sdk">

  <!-- KeyPlus: the keys a phone's keyboard lacks (Esc, Tab, Ctrl, Alt, Shift,
       arrows, Home, End, pages), sent to the field being typed in. The popup
       is an accessibility service in a strip above whatever keyboard is
       open: Android 13 lets one write to the focused editor beside the
       user's own keyboard, which is why the minimum is API 33. -->

  <!-- The versions this checkout's builds have reached (build-apk.ps1 bumps
       them there, never here), so building APKs changes no tracked file,
       whoever builds. Taken only when above the release's. -->
  <Import Project="$(MSBuildThisFileDirectory)private\version.props" Condition="Exists('$(MSBuildThisFileDirectory)private\version.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Berpiztu.KeyPlus</RootNamespace>
    <ApplicationId>ai.berpiztu.keyplus</ApplicationId>
    <!-- The release's version, changed only when one is published
         (deploy-release.ps1): ApplicationDisplayVersion is the Android
         versionName, ApplicationVersion its versionCode, the version as one
         number (1.0.40 is 100040000). A build of this checkout counts itself
         as a fourth part (1.0.40.3, versionCode 100040003) in
         private\version.props, taken here when above the release's. -->
    <ApplicationDisplayVersion>1.0.40</ApplicationDisplayVersion>
    <ApplicationVersion>100040000</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(KeyPlusLocalVersion)' != '' And $([MSBuild]::VersionGreaterThan('$(KeyPlusLocalVersion)', '$(ApplicationDisplayVersion)'))">$(KeyPlusLocalVersion)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(KeyPlusLocalBuild)' != '' And $(KeyPlusLocalBuild) &gt; $(ApplicationVersion)">$(KeyPlusLocalBuild)</ApplicationVersion>
    <!-- Only the APK, which is copied to the phone: no app bundle for a store,
         nor the bundletool step that turns one into APKs. -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- 64-bit ARM only: the phones it runs on, and a smaller APK than one
         carrying the x86 and 32-bit runtimes too. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <Authors>Berpiztu</Authors>
    <Copyright>Copyright (c) 2026 Berpiztu</Copyright>
  </PropertyGroup>

  <!-- Two products from the same code, each an app of its own, so both can
       be on one phone (-p:KeyPlusProduct=Keyboard):
       Popup, the accessibility service's window above the user's keyboard;
       Keyboard, Berpiztu AI Keyboard, the keys as a keyboard of their own,
       for any Android and for a
       headset (Galaxy XR), which keeps a popup before the user's eyes and
       places only a keyboard where the user moves it. Each builds into its
       own folders, so neither reuses the other's. -->
  <PropertyGroup>
    <KeyPlusProduct Condition="'$(KeyPlusProduct)' == ''">Popup</KeyPlusProduct>
    <OutputPath>bin\$(KeyPlusProduct)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(KeyPlusProduct)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <ApplicationId>ai.berpiztu.keyboard</ApplicationId>
    <DefineConstants>$(DefineConstants);KEYBOARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <Compile Remove="KeyPlusService.cs;SelectionInputMethod.cs;KeyWindowActivity.cs" />
    <AndroidResource Remove="Resources\xml\keyplus_accessibility.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(KeyPlusProduct)' != 'Keyboard'">
    <Compile Remove="KeyPlusKeyboard.cs;ClipboardImages.cs;ScreenshotWatcher.cs" />
    <AndroidResource Remove="Resources\xml\keyplus_keyboard.xml" />
  </ItemGroup>

</Project>
