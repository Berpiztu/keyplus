<Project Sdk="Microsoft.NET.Sdk">

  <!-- KeyPlus: the keys a phone's keyboard lacks (Esc, Tab, Ctrl, Alt, Shift,
       arrows, Home, End, pages), sent to the field being typed in. The popup
       is an accessibility service in a strip above whatever keyboard is
       open: Android 13 lets one write to the focused editor beside the
       user's own keyboard, which is why the minimum is API 33. -->

  <!-- The versions this checkout's builds have reached (build-apk.ps1 bumps
       them there, never here), so building APKs changes no tracked file,
       whoever builds. Taken only when above the release's. -->
  <Import Project="$(MSBuildThisFileDirectory)private\version.props" Condition="Exists('$(MSBuildThisFileDirectory)private\version.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Berpiztu.KeyPlus</RootNamespace>
    <ApplicationId>ai.berpiztu.keyplus</ApplicationId>
    <!-- The release's version, changed only when one is published
         (deploy-release.ps1): ApplicationDisplayVersion is the Android
         versionName, ApplicationVersion its versionCode, the version as one
         number (1.0.40 is 100040000). A build of this checkout counts itself
         as a fourth part (1.0.40.3, versionCode 100040003) in
         private\version.props, taken here when above the release's. -->
    <ApplicationDisplayVersion>1.0.69</ApplicationDisplayVersion>
    <ApplicationVersion>100069000</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(KeyPlusLocalVersion)' != '' And $([MSBuild]::VersionGreaterThan('$(KeyPlusLocalVersion)', '$(ApplicationDisplayVersion)'))">$(KeyPlusLocalVersion)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(KeyPlusLocalBuild)' != '' And $(KeyPlusLocalBuild) &gt; $(ApplicationVersion)">$(KeyPlusLocalBuild)</ApplicationVersion>
    <!-- Only the APK, which is copied to the phone: no app bundle for a store,
         nor the bundletool step that turns one into APKs. -->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- 64-bit ARM only: the phones it runs on, and a smaller APK than one
         carrying the x86 and 32-bit runtimes too. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <Authors>Berpiztu</Authors>
    <Copyright>Copyright (c) 2026 Berpiztu</Copyright>
  </PropertyGroup>

  <!-- Two products from the same code, each an app of its own, so both can
       be on one phone (-p:KeyPlusProduct=Keyboard):
       Popup, the accessibility service's window above the user's keyboard;
       Keyboard, Berpiztu AI Keyboard, the keys as a keyboard of their own,
       for any Android and for a
       headset (Galaxy XR), which keeps a popup before the user's eyes and
       places only a keyboard where the user moves it. Each builds into its
       own folders, so neither reuses the other's. -->
  <PropertyGroup>
    <KeyPlusProduct Condition="'$(KeyPlusProduct)' == ''">Popup</KeyPlusProduct>
    <OutputPath>bin\$(KeyPlusProduct)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(KeyPlusProduct)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Debug builds signed with KeyPlus's own key where this checkout has it
       (private\android.keystore, its password alone in the .pass file
       beside it), as the release APKs are (packaging\Packaging.ps1): either
       installs over the other, with no uninstalling, and the device keeps
       what it allowed the app. Without it, Android's debug key. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)private\android.keystore') And Exists('$(MSBuildThisFileDirectory)private\android.keystore.pass')">
    <KeyPlusDebugKeyPass>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)private\android.keystore.pass').Trim())</KeyPlusDebugKeyPass>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)private\android.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>$(KeyPlusDebugKeyPass)</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>keyplus</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(KeyPlusDebugKeyPass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- The app's own ADB client over the device's Wireless debugging
       (AdbShell.java, AdbGrant.cs), which turns on what an ADB app on the
       device or a computer turns on: libadb-android (Apache-2.0 of its
       GPL-3.0-or-later OR Apache-2.0) and its SPAKE2 pairing (LGPL-3.0), from
       JitPack; BouncyCastle at a release with no known vulnerability, above
       the 1.81 libadb asks for; Conscrypt for TLS 1.3 and its keying
       material, so no hidden Android API is used. Java alone calls them, so
       no C# binding is generated. -->
  <ItemGroup Condition="'$(KeyPlusAdb)' == 'true'">
    <AndroidMavenLibrary Include="com.github.MuntashirAkon:libadb-android" Version="3.1.1" Repository="https://jitpack.io" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.github.MuntashirAkon.spake2-java:spake2-android" Version="2.2.1" Repository="https://jitpack.io" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="org.bouncycastle:bcprov-jdk15to18" Version="1.86" Bind="false" />
    <AndroidMavenLibrary Include="org.conscrypt:conscrypt-android" Version="2.7.0" Bind="false" />
    <AndroidJavaSource Update="AdbShell.java" Bind="false" />
  </ItemGroup>

  <!-- windows\ is Berpiztu AI Keyboard for Windows, a project of its own
       that compiles the standard keyboards' layouts from here: none of it
       is Android's. -->
  <ItemGroup>
    <Compile Remove="windows\**;packaging\windows-install\**;adb\**" />
    <None Remove="windows\**;packaging\windows-install\**;adb\**" />
    <EmbeddedResource Remove="windows\**;packaging\windows-install\**;adb\**" />
  </ItemGroup>
  <!-- Nothing under windows\ is gathered by Android's own globs either: the Windows build's output carries ONNX Runtime
       for every platform (an .aar, Linux .so files), never Android's libraries. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);windows\**;packaging\windows-install\**;adb\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <ApplicationId>ai.berpiztu.keyboard</ApplicationId>
    <DefineConstants>$(DefineConstants);KEYBOARD</DefineConstants>
  </PropertyGroup>

  <!-- Parts a build may leave out, each set to true or false here:
       KeyPlusAdb, turning the app on over Wireless debugging (AdbGrant.cs,
       AdbShell.java and their libraries, with the notification the code is
       typed in), on; KeyPlusSelfInstall, an update installed by the app
       itself (REQUEST_INSTALL_PACKAGES), else its release's page opened on
       GitHub, off: Play Protect calls the apps harmful while they may
       install packages (1.0.54, 1.0.56 and 1.0.57 with it, 1.0.55, 1.0.58
       and 1.0.59 without); KeyPlusFieldColor, the menu watch's screenshot
       of the field's colour (App's as the application shows), else App's
       takes its theme's, on. -->
  <PropertyGroup>
    <KeyPlusAdb Condition="'$(KeyPlusAdb)' == ''">true</KeyPlusAdb>
    <KeyPlusSelfInstall Condition="'$(KeyPlusSelfInstall)' == ''">false</KeyPlusSelfInstall>
    <KeyPlusFieldColor Condition="'$(KeyPlusFieldColor)' == ''">true</KeyPlusFieldColor>
    <DefineConstants Condition="'$(KeyPlusAdb)' == 'true'">$(DefineConstants);ADB</DefineConstants>
    <DefineConstants Condition="'$(KeyPlusSelfInstall)' == 'true'">$(DefineConstants);SELF_INSTALL</DefineConstants>
    <DefineConstants Condition="'$(KeyPlusFieldColor)' == 'true'">$(DefineConstants);FIELD_COLOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(KeyPlusAdb)' != 'true'">
    <Compile Remove="AdbGrant.cs" />
    <AndroidJavaSource Remove="AdbShell.java" />
  </ItemGroup>
  <ItemGroup Condition="'$(KeyPlusFieldColor)' == 'true'">
    <AndroidResource Remove="Resources\xml\keyboard_menus.xml" />
  </ItemGroup>
  <ItemGroup Condition="'$(KeyPlusFieldColor)' != 'true'">
    <AndroidResource Remove="Resources\xml\keyboard_menus_color.xml" />
  </ItemGroup>

  <ItemGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <Compile Remove="KeyPlusService.cs;SelectionInputMethod.cs;KeyWindowActivity.cs" />
    <AndroidResource Remove="Resources\xml\keyplus_accessibility.xml" />
  </ItemGroup>

  <!-- Swipe typing, Berpiztu AI Keyboard's: FUTO Swipe's library (GPL-3.0,
       built by native/futo-swipe/build.sh; .NET takes the .so files under
       their ABI's folder by itself) and its licence, under Assets; its
       encoder and each language's AOSP word list are downloaded as a
       language's Glide typing is turned on (SwipeData.cs), never carried. -->
  <ItemGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <AndroidJavaSource Update="SwipeDecoder.java" Bind="false" />
  </ItemGroup>

  <!-- Spelling, Berpiztu AI Keyboard's, as Windows': Hunspell ported to .NET
       (no native parts) for the words, ONNX Runtime for the accent and
       punctuation models, and Microsoft.ML.Tokenizers for the latter's
       SentencePiece; their dictionaries and models are downloaded when turned
       on, never carried. -->
  <ItemGroup Condition="'$(KeyPlusProduct)' == 'Keyboard'">
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(KeyPlusProduct)' != 'Keyboard'">
    <Compile Remove="KeyPlusKeyboard.cs;ClipboardImages.cs;ScreenshotWatcher.cs;SwipeTyping.cs;SettingsScreen.cs;ThemeView.cs;ColorsRow.cs;MenuWatchService.cs;AccentModel.cs;PunctuationModel.cs;ContextCorrector.cs;SpellingDictionary.cs;CommonErrors.cs;Downloads.cs;Loaded.cs;SwipeData.cs;LanguageChoices.cs;SpellingEngine.cs;LanguageOptions.cs" />
    <AndroidResource Remove="Resources\xml\keyplus_keyboard.xml;Resources\xml\keyboard_menus.xml;Resources\xml\keyboard_menus_color.xml" />
    <AndroidJavaSource Remove="SwipeDecoder.java" />
    <AndroidAsset Remove="Assets\**" />
    <AndroidNativeLibrary Remove="native\**" />
  </ItemGroup>

</Project>
