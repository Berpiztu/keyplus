<Project Sdk="Microsoft.NET.Sdk">

  <!-- Berpiztu AI Keyboard for Windows: the standard keyboards (Estándar and
       Estándar PC) in a card that floats over every window, never taking the
       focus from the one typed in, the keys sent to it as Windows' own. The
       layouts and the keys' signs are the Android keyboard's, compiled from
       ..\ as they are (StandardKeys.cs, Resources\drawable); the Android names
       they use are AndroidNames.cs's. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004's SDK: UISettings, the user's accent colours. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Berpiztu.KeyPlus</RootNamespace>
    <AssemblyName>BerpiztuKeyboard</AssemblyName>
    <Product>Berpiztu AI Keyboard</Product>
    <Authors>Berpiztu</Authors>
    <Copyright>Copyright (c) 2026 Berpiztu</Copyright>
  </PropertyGroup>

  <!-- Direct2D and DirectWrite (MIT): emoji drawn in colour as Windows draws
       them, which WPF's own text cannot (EmojiArt.cs). -->
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <!-- The microphone, for 🎤 (VoiceTyping.cs): NAudio (MIT), its long-standing 2.2.1. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\StandardKeys.cs" Link="Shared\StandardKeys.cs" />
    <Compile Include="..\SwipeWords.cs" Link="Shared\SwipeWords.cs" />
    <Compile Include="..\EmojiList.cs" Link="Shared\EmojiList.cs" />
    <Content Include="..\Resources\drawable\ic_key_*.xml;..\Resources\drawable\ic_emoji_*.xml;..\Resources\drawable\ic_grid_pc.xml;..\Resources\drawable\ic_grid_phone.xml;..\Resources\drawable\ic_tool_close.xml;..\Resources\drawable\ic_tool_back.xml;..\Resources\drawable\ic_tool_mic.xml"
             LinkBase="drawable" CopyToOutputDirectory="PreserveNewest" />
    <!-- The words, the Android keyboard's, in English and Spanish (Texts.cs). -->
    <Content Include="..\Resources\values\strings.xml" Link="strings\values\strings.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Resources\values-es\strings.xml" Link="strings\values-es\strings.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Emoji: Unicode's list, drawn in colour by Direct2D (EmojiArt.cs). -->
    <Content Include="..\Assets\emoji\*.txt" LinkBase="emoji" CopyToOutputDirectory="PreserveNewest" />
    <!-- Swipe typing: FUTO Swipe built for Windows (native\futo-swipe\windows\build.ps1),
         its encoder and AOSP's word lists, the Android keyboard's. -->
    <Content Include="..\native\futo-swipe\win-x64\keyplus_swipe.dll" Link="keyplus_swipe.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\native\futo-swipe\win-x64\keyplus_swipe.dll')" />
    <Content Include="..\Assets\futo-swipe\honorable_sturgeon\*" LinkBase="futo-swipe\honorable_sturgeon" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\futo-swipe\LICENSE.md" Link="futo-swipe\LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\dictionaries\*.gz" LinkBase="dictionaries" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
